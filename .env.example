OPENAI_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
OPENAI_API_KEY=replace-me
OPENAI_MODEL=mimo-v2.5-pro
CR_AGENT_LLM_TIMEOUT_SECONDS=300
# Optional: enabled|disabled|auto. When unset/auto and OPENAI_BASE_URL is deepseek.com,
# CR-Agent sends {"thinking":{"type":"disabled"}} for tool-call compatibility.
CR_AGENT_LLM_THINKING_MODE=auto
# DeepSeek context cache is server-side and needs no extra request parameter.
# Cache hit/miss tokens are recorded in trace llm_usage events when the provider returns them.

# Optional. Without a token, the agent can still run dry-run/local simulated flows.
GITHUB_TOKEN=

CR_AGENT_DRY_RUN=true
CR_AGENT_TRACE_DIR=data/traces
CR_AGENT_MEMORY_DIR=data/memory
CR_AGENT_MEMORY_READ_ENABLED=true
CR_AGENT_REPORT_DIR=report
CR_AGENT_REPO_AUDIT_RUN_CHECKS=true
CR_AGENT_LSP_ENABLED=true
CR_AGENT_LSP_TIMEOUT_SECONDS=30
CR_AGENT_VERIFIER_ENABLED=true
CR_AGENT_VERIFIER_MAX_CANDIDATES=8
CR_AGENT_REVIEW_MAX_COMMENTS=12
CR_AGENT_REVIEW_PUBLISH_THRESHOLD=0.25
CR_AGENT_ZERO_ISSUE_RECOVERY=true
CR_AGENT_LANGUAGE_SKILLS_ENABLED=true
CR_AGENT_LANGUAGE_SKILL_MAX_SELECTED=6
CR_AGENT_RECOVERY_MAX_TOOL_ROUNDS=6
CR_AGENT_VERIFIER_MAX_TOOL_ROUNDS=4
CR_AGENT_REPO_BATCH_MAX_TOOL_ROUNDS=6
CR_AGENT_LLM_TRIAGE_ADVICE=true
CR_AGENT_LLM_CONTEXT_SCOUT=true
CR_AGENT_LLM_RISK_REFINEMENT=true
CR_AGENT_LLM_TEST_REASONING=true
CR_AGENT_LLM_ACT_PLANNING=false
CR_AGENT_CONTEXT_RRF_K=60
CR_AGENT_CONTEXT_MAX_ITEMS=40
